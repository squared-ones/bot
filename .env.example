# Discord bot token (from the Bot section of your Discord application)
DISCORD_TOKEN=your-bot-token

# Application ID (used for the bot invite link and OAuth)
CLIENT_ID=your-application-id

# OAuth2 client secret (from the OAuth2 section). Setting this enables the
# dashboard login and scopes channel access to your own servers.
CLIENT_SECRET=your-oauth2-client-secret

# Secret used to sign the session cookie. Generate a long random string.
# Defaults to CLIENT_SECRET if unset.
SESSION_SECRET=a-long-random-secret

# Set to true to disable username/password accounts (they are enabled by
# default). If both Discord OAuth and local accounts are disabled, the
# dashboard runs unprotected.
# DISABLE_LOCAL_AUTH=true

# Port for the web dashboard
PORT=3000

# Set to true when serving the dashboard over HTTPS (marks session cookies Secure)
# COOKIE_SECURE=true

# Set to true when running behind a trusted reverse proxy so VPN detection can
# read the original client IP from Express's proxy-aware request handling.
# TRUST_PROXY=true

# ---------- GitHub data storage ----------
# Fine-grained token with Contents read/write access to the private data repo.
GITHUB_TOKEN=
GITHUB_DATA_REPO=squared-ones/data
GITHUB_DATA_BRANCH=main

# ---------- Voting webhooks ----------
# SQ credits awarded to the voter for each non-duplicate vote (default 50).
# Set to 0 to disable vote rewards.
# VOTE_CREDIT_REWARD=50

# Top.gg v1 webhook secret (starts with whs_).
TOPGG_WEBHOOK_SECRET=

# Discord Bot List webhook Authorization token.
DBL_WEBHOOK_TOKEN=

# Discord Bot List API token (used to sync the slash-command list and post bot
# statistics to the bot page).
DBL_API_TOKEN=

# ---------- Translations ----------
# SQ credits awarded to a contributor for each approved human translation
# (default 5). Set to 0 to disable translation rewards.
# TRANSLATION_REWARD=5

# ---------- Error reporting & community rewards ----------
# Discord channel that receives an embed whenever the bot hits an error.
# ERROR_LOG_CHANNEL_ID=1538424909682835569

# Role granted when a contributor's translation is approved.
# TRANSLATION_ROLE_ID=1538425335383859290

# Role granted temporarily when a user votes on a bot list.
# VOTE_ROLE_ID=1538425940311277619

# How long (ms) the voter role lasts before it is removed (default 12h).
# VOTE_ROLE_DURATION_MS=43200000

# ---------- Support page ----------
# Discord invite URL for your support server (shown on /support).
# SUPPORT_SERVER=https://discord.gg/yourinvite

# Repository URL (used for the "Report a bug" link on /support).
# GITHUB_URL=https://github.com/you/squared-one
