{
  "name": "squared-one",
  "version": "1.0.0",
  "description": "Squared One — multitool Discord bot (moderation, rules, verification, voting, tickets, leveling, and more) with an OAuth-protected web dashboard.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "build": "node scripts/build.js",
    "package:worker": "node scripts/package-worker.js",
    "start:dist": "node dist/index.js",
    "client:build:ts": "tsc && tsc-alias && node -e \"require('fs').writeFileSync('build/package.json', JSON.stringify({type:'commonjs'}))\"",
    "client:test:typescript": "tsc --noEmit",
    "client:lint": "eslint src --ext .ts",
    "client:lint:fix": "eslint src --ext .ts --fix",
    "client:format": "prettier --write src/**/*.ts",
    "client:core:update": "tsx scripts/update.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "discord.js": "^14.16.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "@sapphire/snowflake": "^3.5.5",
    "discord-api-types": "^0.38.50",
    "ini": "^6.0.0",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "murmurhash": "^2.0.1",
    "probe-image-size": "^7.3.0",
    "undici": "^7.24.3"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.22.0",
    "esbuild": "^0.28.2",
    "javascript-obfuscator": "^5.5.0",
    "@eslint/js": "^9.39.2",
    "@types/express": "^4.17.23",
    "@types/ini": "^4.1.1",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.1",
    "@types/probe-image-size": "^7.2.5",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^17.23.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-header": "^1.2.2",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "eslint-plugin-unused-imports": "^4.3.0",
    "prettier": "^3.9.6",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/squared-ones/bot.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/squared-ones/bot/issues"
  },
  "homepage": "https://github.com/squared-ones/bot#readme"
}
